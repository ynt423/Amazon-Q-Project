# API Configuration
# Copy this file to .env and add your actual API keys

# Gemini AI API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (for alternative AI models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tiingo API Key (for financial news and data)
TIINGO_API_KEY=your_tiingo_api_key_here

# NewsAPI Key (for news aggregation)
NEWSAPI_KEY=your_newsapi_key_here

# Alpha Vantage API Key (for financial data)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Yahoo Finance (no API key required, but can be configured for rate limiting)
YAHOO_FINANCE_API_KEY=optional_yahoo_finance_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here

# Database Configuration
DATABASE_URL=sqlite:///stock_analysis.db

# Optional: Redis for caching (if implemented)
REDIS_URL=redis://localhost:6379/0
